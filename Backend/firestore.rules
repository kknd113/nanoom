rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(groupID) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(groupID)/members/$(request.auth.uid));
    }
    function author(groupID, prayerID) {
      return signedIn() && get(/databases/$(database)/documents/groups/$(groupID)/prayers/$(prayerID)).data.authorID == request.auth.uid;
    }
    function validBody(data) { return data.body is string && data.body.size() > 0 && data.body.size() <= 2000; }

    match /users/{userID}/groupMemberships/{groupID} {
      allow read: if signedIn() && request.auth.uid == userID;
      allow write: if false; // Trusted server creates this together with membership.
    }
    match /groups/{groupID} {
      allow read: if member(groupID);
      allow write: if false;
      match /members/{userID} {
        allow read: if member(groupID);
        allow write: if false;
      }
      match /prayers/{prayerID} {
        allow read: if member(groupID);
        allow create: if member(groupID)
          && request.resource.data.keys().hasOnly(['authorID', 'body', 'createdAt'])
          && request.resource.data.authorID == request.auth.uid
          && request.resource.data.createdAt == request.time
          && validBody(request.resource.data);
        allow update: if member(groupID) && resource.data.authorID == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body'])
          && validBody(request.resource.data);
        allow delete: if false; // Server must delete subcollections as well.
        match /updates/{updateID} {
          allow read: if member(groupID);
          allow create: if member(groupID) && author(groupID, prayerID)
            && request.resource.data.keys().hasOnly(['authorID', 'body', 'createdAt'])
            && request.resource.data.authorID == request.auth.uid
            && request.resource.data.createdAt == request.time
            && validBody(request.resource.data);
          allow update, delete: if false;
        }
        match /reactions/{userID} {
          allow read: if member(groupID);
          allow create: if member(groupID) && request.auth.uid == userID && !author(groupID, prayerID)
            && request.resource.data.keys().hasOnly(['createdAt'])
            && request.resource.data.createdAt == request.time;
          allow delete: if member(groupID) && request.auth.uid == userID;
          allow update: if false;
        }
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
